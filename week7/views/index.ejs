<!DOCTYPE html>
<html>
<head>
    <title>User Registration</title>
</head>

<body>

    <h1>User Registration</h1>

    <form method="POST" action="/submit">

        <label>Name:</label>
        <input type="text" name="username">

        <br><br>

        <label>Age:</label>
        <input type="number" name="age">

        <br><br>

        <button type="submit">Submit</button>

    </form>

</body>
</html>
